    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Clasifica la siguiente pregunta del usuario en una sola categoría.\\nResponde ÚNICAMENTE con una de estas palabras exactas, sin añadir nada más:\\n\\n- CLIMA (preguntas sobre meteorología, tiempo atmosférico, temperatura, lluvia, sol, viento, pronóstico)\\n- PAIS (preguntas sobre países, ciudades, capitales, población, continentes)\\n- WIKI (preguntas sobre historia, ciencia, tecnología, personas famosas, definiciones generales)\\n- CHISTE (peticiones de chistes, bromas, humor)\\n- GENERAL (cualquier otra cosa)\\n\\nEjemplos:\\n\"¿Qué tiempo hace en Madrid?\" → CLIMA\\n\"¿Va a llover mañana?\" → CLIMA\\n\"¿Cuál es la capital de Francia?\" → PAIS\\n\"¿Quién fue Einstein?\" → WIKI\\n\"Cuéntame un chiste\" → CHISTE\\n\"¿Cómo te llamas?\" → GENERAL\\n\\nPregunta a clasificar: ' + $('Webhook Chatbot').item.json.body.mensaje }}\n"
      },
      "id": "f78b70e2-564e-4cd1-bf16-d0dea14d05a3",
      "name": "Analizador de Intención",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
