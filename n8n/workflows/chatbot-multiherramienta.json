    {
      "parameters": {
        "prompt": "={{ 'Analiza la siguiente pregunta del usuario y decide a qué categoría pertenece.\\nResponde ÚNICAMENTE con una de las siguientes palabras SIN añadir nada más:\\n- CLIMA (si pregunta por el tiempo, temperatura, lluvia, meteorología)\\n- PAIS (si pregunta datos sobre un país, nación, ciudad o capital)\\n- WIKI (si pregunta sobre historia, personas famosas, ciencia, tecnología u otros conceptos generales)\\n- CHISTE (si pide un chiste, humor o algo gracioso)\\n- GENERAL (para cualquier otra pregunta que no encaje en las anteriores)\\n\\nPregunta: ' + $json.body.mensaje }}",
        "options": {}
      },
      "id": "2d8fab02-1a2b-3c4d-5e6f-7a8b9c0d1e2f",
      "name": "Analizador de Intención",
